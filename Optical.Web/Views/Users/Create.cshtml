@model Optical.Web.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "New Staff Account";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="app-brand-title">New Staff Account</h1>
        <p class="app-brand-subtitle">The person signs in with this username and password</p>
    </div>
    <a class="btn btn-light border" asp-action="Index">Back to accounts</a>
</div>

<div class="app-card p-4" style="max-width:720px">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="UserName"></label>
                <input class="form-control" asp-for="UserName" autocomplete="off" />
                <span class="text-danger" asp-validation-for="UserName"></span>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="FullName"></label>
                <input class="form-control" asp-for="FullName" autocomplete="off" />
                <span class="text-danger" asp-validation-for="FullName"></span>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Email">Email (optional)</label>
                <input class="form-control" asp-for="Email" autocomplete="off" />
                <span class="text-danger" asp-validation-for="Email"></span>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Role"></label>
                <select class="form-select" asp-for="Role" asp-items="Model.Roles"></select>
                <span class="text-danger" asp-validation-for="Role"></span>
                <span class="stat-hint">Cashier works the till only. Owner runs the shop. Admin also manages accounts.</span>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Password"></label>
                <div class="input-group">
                    <input class="form-control" asp-for="Password" autocomplete="new-password" />
                    <partial name="_PasswordToggle" />
                </div>
                <span class="text-danger" asp-validation-for="Password"></span>
                <span class="stat-hint">At least 8 characters. Give it to them directly, never by email.</span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Create account</button>
            <a class="btn btn-light border" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
