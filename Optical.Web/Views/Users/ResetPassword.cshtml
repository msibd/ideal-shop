@model Optical.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = $"Reset password for {Model.UserName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="app-brand-title">Reset Password</h1>
        <p class="app-brand-subtitle">For @Model.UserName</p>
    </div>
    <a class="btn btn-light border" asp-action="Index">Back to accounts</a>
</div>

<div class="app-card p-4" style="max-width:560px">
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserName" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="alert alert-warning" role="alert">
            You are setting this password yourself, without knowing the old one. Hand it over in
            person and ask them to change it from their own profile.
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="NewPassword"></label>
            <div class="input-group">
                <input class="form-control" asp-for="NewPassword" autocomplete="new-password" />
                <partial name="_PasswordToggle" />
            </div>
            <span class="text-danger" asp-validation-for="NewPassword"></span>
            <span class="stat-hint">At least 8 characters.</span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="ConfirmPassword"></label>
            <div class="input-group">
                <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
                <partial name="_PasswordToggle" />
            </div>
            <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Set password</button>
            <a class="btn btn-light border" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
