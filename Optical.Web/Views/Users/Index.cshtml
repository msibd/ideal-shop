@using Optical.Application.Common
@model IReadOnlyList<Optical.Application.Abstractions.Identity.StaffUser>
@{
    ViewData["Title"] = "Staff Accounts";
    var currentUserId = ViewData["CurrentUserId"] as string;

    string RoleChip(string role) => role switch
    {
        AppRoles.Admin => "chip chip-brand",
        AppRoles.Owner => "chip chip-category",
        _ => "chip"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="app-brand-title">Staff Accounts</h1>
        <p class="app-brand-subtitle">@Model.Count account(s) — only an Admin can create or change these</p>
    </div>
    <a class="action-btn action-solid-1 w-auto" asp-action="Create">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <line x1="19" y1="8" x2="19" y2="14" />
            <line x1="22" y1="11" x2="16" y2="11" />
        </svg>
        New Account
    </a>
</div>

<div class="app-card mb-3">
    <div class="app-card-header">
        <span class="app-card-title">What each role can do</span>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Roles" asp-action="Index">
            Roles &amp; permissions
        </a>
    </div>
    <div class="p-4">
        <p class="meta-line mb-0">
            Module access is set per role on the Roles &amp; Permissions screen, and it can be
            changed at any time. A role decides what the person can reach, so pick it with that
            screen open if you are unsure.
        </p>
    </div>
</div>

<div class="app-card">
    <div class="table-responsive">
        <table class="table app-table mb-0">
            <thead>
                <tr>
                    <th scope="col">Username</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="row-brand">
                        <td class="cell-primary">
                            @user.UserName
                            @if (user.Id == currentUserId)
                            {
                                <span class="badge text-bg-secondary ms-1">You</span>
                            }
                        </td>
                        <td class="cell-secondary">@user.FullName</td>
                        <td class="cell-secondary">@(user.Email ?? "—")</td>
                        <td><span class="@RoleChip(user.Role)">@user.Role.ToUpperInvariant()</span></td>
                        <td>
                            <span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(user.IsActive ? "Active" : "Disabled")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@user.Id">Reset password</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
