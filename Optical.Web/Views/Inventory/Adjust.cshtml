@model Optical.Web.ViewModels.StockAdjustmentViewModel
@{
    ViewData["Title"] = "Adjust stock";
}

<h1 class="app-brand-title mb-3">Adjust stock</h1>

<div class="row">
    <div class="col-12 col-lg-6">
        <div class="app-card p-4">
            <form asp-action="Adjust" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="Sku" />
                <input type="hidden" asp-for="ProductName" />
                <input type="hidden" asp-for="CurrentQuantity" />

                <p class="stat-label">Product</p>
                <p class="stat-value mb-3">@Model.ProductName</p>

                <p class="stat-label">SKU</p>
                <p class="meta-line mb-3">@Model.Sku</p>

                <p class="stat-label">Current stock</p>
                <p class="stat-value mb-3">@Model.CurrentQuantity</p>

                <div class="mb-3">
                    <label asp-for="NewQuantity" class="form-label fw-semibold"></label>
                    <input asp-for="NewQuantity" class="form-control money" type="number" step="1" min="0" autofocus />
                    <span asp-validation-for="NewQuantity" class="text-danger small"></span>
                    <span class="stat-hint d-block mt-1">
                        Enter the quantity you actually counted. It replaces the current stock.
                    </span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">Save adjustment</button>
                    <a class="btn btn-light border" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
