@model Optical.Web.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "New product";
}

<h1 class="app-brand-title mb-3">New product</h1>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="app-card p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="Sku" class="form-label fw-semibold"></label>
                        <input asp-for="Sku" class="form-control" autofocus placeholder="e.g. FRM-0012" />
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Barcode" class="form-label fw-semibold"></label>
                        <input asp-for="Barcode" class="form-control" autocomplete="off"
                               placeholder="Scan it, or leave empty" />
                        <div class="form-check mt-1">
                            <input asp-for="GenerateBarcode" class="form-check-input" type="checkbox" />
                            <label asp-for="GenerateBarcode" class="form-check-label small"></label>
                        </div>
                        <span class="text-secondary small">
                            Scan the manufacturer's barcode into the box, or tick to have one
                            generated when the product has none.
                        </span>
                        <span asp-validation-for="Barcode" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">— Select a category —</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="BrandId" class="form-label fw-semibold"></label>
                        <select asp-for="BrandId" asp-items="Model.Brands" class="form-select">
                            <option value="">— Select a brand —</option>
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="PurchasePrice" class="form-label fw-semibold"></label>
                        <input asp-for="PurchasePrice" class="form-control money" type="number" step="0.01" min="0" />
                        <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="SalePrice" class="form-label fw-semibold"></label>
                        <input asp-for="SalePrice" class="form-control money" type="number" step="0.01" min="0" />
                        <span asp-validation-for="SalePrice" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="ReorderLevel" class="form-label fw-semibold"></label>
                        <input asp-for="ReorderLevel" class="form-control money" type="number" step="1" min="0" />
                        <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                    </div>
                </div>

                <partial name="_DiscountFields" model="Model" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">Save</button>
                    <a class="btn btn-light border" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
