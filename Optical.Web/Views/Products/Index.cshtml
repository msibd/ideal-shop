@model Optical.Application.Features.Products.ProductListResult
@{
    ViewData["Title"] = "Products";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="app-brand-title">Products</h1>
        <p class="app-brand-subtitle">@Model.TotalCount product(s) in the catalogue</p>
    </div>
    <a class="action-btn action-solid-1 w-auto" asp-action="Create">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="16" />
            <line x1="8" y1="12" x2="16" y2="12" />
        </svg>
        New Product
    </a>
</div>

<div class="app-card">
    <div class="app-card-header">
        <form class="d-flex gap-2 flex-grow-1" asp-action="Index" method="get">
            <input class="form-control" style="max-width:340px" name="search" value="@search"
                   placeholder="Search by name, SKU or barcode" />
            <button class="btn btn-primary" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="btn btn-link text-decoration-none" asp-action="Index">Clear</a>
            }
        </form>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="p-4 text-center stat-hint">No products found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table">
                <thead>
                    <tr>
                        <th scope="col">SKU</th>
                        <th scope="col">Product</th>
                        <th scope="col">Category</th>
                        <th scope="col">Brand</th>
                        <th scope="col" class="text-end">Purchase</th>
                        <th scope="col" class="text-end">Sale</th>
                        <th scope="col">Discount</th>
                        <th scope="col" class="text-end">Reorder</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Items)
                    {
                        <tr class="row-category">
                            <td class="cell-secondary" style="font-variant-numeric: tabular-nums">
                                @product.Sku
                                @if (!string.IsNullOrWhiteSpace(product.Barcode))
                                {
                                    <span class="cell-secondary d-block">@product.Barcode</span>
                                }
                            </td>
                            <td class="cell-primary">@product.Name</td>
                            <td>
                                <span class="chip chip-category">@product.CategoryName.ToUpperInvariant()</span>
                            </td>
                            <td>
                                <span class="chip chip-brand">@product.BrandName.ToUpperInvariant()</span>
                            </td>
                            <td class="text-end money">@product.PurchasePrice.ToString("N2")</td>
                            <td class="text-end money fw-semibold">@product.SalePrice.ToString("N2")</td>
                            <td>
                                @if (product.IsDiscountRunning)
                                {
                                    <span class="badge bg-success">@product.DiscountPercent.ToString("0.##")% off</span>
                                    <span class="cell-secondary d-block">until @product.DiscountEndsOn!.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else if (product.HasDormantDiscount)
                                {
                                    <span class="badge bg-secondary">@product.DiscountPercent.ToString("0.##")% scheduled</span>
                                    <span class="cell-secondary d-block">
                                        @product.DiscountStartsOn!.Value.ToString("dd/MM/yyyy") – @product.DiscountEndsOn!.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="cell-secondary">—</span>
                                }
                            </td>
                            <td class="text-end money">@product.ReorderLevel</td>
                            <td>
                                <span class="chip @(product.IsActive ? "chip-active" : "chip-inactive")">
                                    @(product.IsActive ? "ACTIVE" : "INACTIVE")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@product.Id">Details</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="app-card-header border-top border-bottom-0">
                <span class="stat-hint">
                    Page @Model.Page of @Model.TotalPages — @Model.TotalCount product(s)
                </span>
                <span class="d-flex gap-2">
                    @if (Model.HasPrevious)
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page - 1)">Previous</a>
                    }
                    @if (Model.HasNext)
                    {
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page + 1)">Next</a>
                    }
                </span>
            </div>
        }
    }
</div>
