@*
    Collapse toggle for a card section. The model is the id of the element to
    collapse, which must carry class="collapse show" and that id.
*@
@model string

<button type="button" class="card-collapse"
        data-bs-toggle="collapse" data-bs-target="#@Model"
        data-collapse-key="@Model"
        aria-expanded="true" aria-controls="@Model"
        aria-label="Show or hide this section">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9" />
    </svg>
</button>
