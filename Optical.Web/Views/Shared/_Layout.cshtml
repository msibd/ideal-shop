@using Optical.Application.Common
@inject Optical.Application.Features.Settings.GetShopSettingsHandler ShopSettingsQuery
@inject Optical.Application.Features.Account.GetProfileHandler ProfileQuery
@inject Optical.Application.Features.Permissions.RolePermissionStore Permissions
@{
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "Home";
    var roles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();

    async Task<bool> CanAsync(string permission) =>
        await Permissions.IsGrantedAsync(roles, permission, Context.RequestAborted);

    var canDashboard = await CanAsync(AppPermissions.Dashboard);
    var canPos = await CanAsync(AppPermissions.Pos);
    var canSales = await CanAsync(AppPermissions.Sales);
    var canCustomers = await CanAsync(AppPermissions.Customers);
    var canCatalog = await CanAsync(AppPermissions.Catalog);
    var canInventory = await CanAsync(AppPermissions.Inventory);
    var canPurchasing = await CanAsync(AppPermissions.Purchasing);
    var canExchanges = await CanAsync(AppPermissions.Exchanges);
    var canReports = await CanAsync(AppPermissions.Reports);
    var canSettings = await CanAsync(AppPermissions.Settings);
    var canManageUsers = await CanAsync(AppPermissions.ManageUsers);
    var canEditOwnProfile = await CanAsync(AppPermissions.Profile);

    var showCatalogGroup = canCatalog;
    var showStockGroup = canInventory || canPurchasing;
    var isBackOffice = showCatalogGroup || showStockGroup || canExchanges || canReports
        || canSettings || canManageUsers;

    // Shop identity comes from System Settings; the defaults apply until it is configured.
    var shop = await ShopSettingsQuery.HandleAsync(Context.RequestAborted);
    var businessName = shop?.BusinessName ?? "Optical Shop";
    var businessSubtitle = shop?.Address ?? "Optical Shop Management v1.0";

    // The header shows the user's own display name, falling back to the sign-in username.
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var profile = isAuthenticated ? await ProfileQuery.HandleAsync(Context.RequestAborted) : null;
    var displayName = string.IsNullOrWhiteSpace(profile?.FullName)
        ? User.Identity?.Name ?? string.Empty
        : profile!.FullName;

    bool IsOn(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase);

    string TabClass(string name) => IsOn(name) ? "app-nav-link active" : "app-nav-link";

    // A group reads as active when any page inside it is the one on screen.
    string GroupClass(params string[] names) =>
        names.Any(IsOn) ? "app-nav-link app-nav-toggle active" : "app-nav-link app-nav-toggle";

    string ItemClass(string name) => IsOn(name) ? "dropdown-item active" : "dropdown-item";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @businessName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center justify-content-between pt-3 pb-2">
                <div class="d-flex align-items-center gap-3">
                    <span class="app-brand-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="7" cy="13" r="4" />
                            <circle cx="17" cy="13" r="4" />
                            <path d="M11 12h2" />
                            <path d="M3 9l2-3h4" />
                            <path d="M21 9l-2-3h-4" />
                        </svg>
                    </span>
                    <div class="app-brand-text">
                        <p class="app-brand-title">@businessName</p>
                        <p class="app-brand-subtitle" title="@businessSubtitle">@businessSubtitle</p>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" href="#"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="text-end d-none d-sm-block">
                                <span class="app-user-name d-block">@displayName</span>
                                <span class="app-user-role">@(roles.FirstOrDefault() ?? AppRoles.Cashier)</span>
                            </span>
                            <span class="app-avatar">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="dropdown-header">Signed in as <strong>@User.Identity!.Name</strong></li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (canEditOwnProfile)
                            {
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2"
                                   asp-controller="Account" asp-action="Profile">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                    Profile Management
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                            <polyline points="16 17 21 12 16 7" />
                                            <line x1="21" y1="12" x2="9" y2="12" />
                                        </svg>
                                        Sign out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="app-nav">
                    @if (canDashboard)
                    {
                    <a class="@TabClass("Home")" asp-controller="Home" asp-action="Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
                        </svg>
                        Dashboard
                    </a>
                    }
                    @if (canPos)
                    {
                    <a class="@TabClass("Pos")" asp-controller="Pos" asp-action="Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="4" width="20" height="12" rx="2" />
                            <line x1="2" y1="9" x2="22" y2="9" />
                            <line x1="7" y1="20" x2="17" y2="20" />
                        </svg>
                        POS
                    </a>
                    }
                    @if (canSales)
                    {
                    <a class="@TabClass("Sales")" asp-controller="Sales" asp-action="Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="8" y1="13" x2="16" y2="13" />
                            <line x1="8" y1="17" x2="13" y2="17" />
                        </svg>
                        Sales
                    </a>
                    }
                    @if (canCustomers)
                    {
                    <a class="@TabClass("Customers")" asp-controller="Customers" asp-action="Index">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        </svg>
                        Customers
                    </a>
                    }
                    @if (isBackOffice)
                    {
                        @if (showCatalogGroup)
                        {
                        <div class="dropdown">
                            <button class="@GroupClass("Products", "Categories", "Brands")" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                                    <line x1="12" y1="22.08" x2="12" y2="12" />
                                </svg>
                                Catalog
                                <svg class="app-nav-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="@ItemClass("Products")" asp-controller="Products" asp-action="Index">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                                            <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                                        </svg>
                                        Products
                                    </a>
                                </li>
                                <li>
                                    <a class="@ItemClass("Categories")" asp-controller="Categories" asp-action="Index">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="3" y="3" width="7" height="7" rx="1" />
                                            <rect x="14" y="3" width="7" height="7" rx="1" />
                                            <rect x="3" y="14" width="7" height="7" rx="1" />
                                            <rect x="14" y="14" width="7" height="7" rx="1" />
                                        </svg>
                                        Categories
                                    </a>
                                </li>
                                <li>
                                    <a class="@ItemClass("Brands")" asp-controller="Brands" asp-action="Index">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z" />
                                            <circle cx="7" cy="7" r="1.5" />
                                        </svg>
                                        Brands
                                    </a>
                                </li>
                            </ul>
                        </div>

                        }

                        @if (showStockGroup)
                        {
                        <div class="dropdown">
                            <button class="@GroupClass("Inventory", "Purchases", "Suppliers")" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 8H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1Z" />
                                    <path d="M4 8v12a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8" />
                                    <line x1="10" y1="13" x2="14" y2="13" />
                                </svg>
                                Stock
                                <svg class="app-nav-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="@ItemClass("Inventory")" asp-controller="Inventory" asp-action="Index">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M20 8H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1Z" />
                                            <path d="M4 8v12a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8" />
                                        </svg>
                                        Inventory
                                    </a>
                                </li>
                                <li>
                                    <a class="@ItemClass("Purchases")" asp-controller="Purchases" asp-action="Index">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                                            <line x1="3" y1="6" x2="21" y2="6" />
                                            <path d="M16 10a4 4 0 0 1-8 0" />
                                        </svg>
                                        Purchases
                                    </a>
                                </li>
                                <li>
                                    <a class="@ItemClass("Suppliers")" asp-controller="Suppliers" asp-action="Index">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="1" y="3" width="15" height="13" rx="1" />
                                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                                            <circle cx="5.5" cy="18.5" r="2.5" />
                                            <circle cx="18.5" cy="18.5" r="2.5" />
                                        </svg>
                                        Suppliers
                                    </a>
                                </li>
                            </ul>
                        </div>

                        }

                        @if (canExchanges)
                        {
                        <a class="@TabClass("Exchanges")" asp-controller="Exchanges" asp-action="Index">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="9 14 4 9 9 4" />
                                <path d="M20 20v-7a4 4 0 0 0-4-4H4" />
                            </svg>
                            Exchanges
                        </a>
                        }

                        @if (canReports)
                        {
                        <a class="@TabClass("Reports")" asp-controller="Reports" asp-action="Sales">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="18" y1="20" x2="18" y2="10" />
                                <line x1="12" y1="20" x2="12" y2="4" />
                                <line x1="6" y1="20" x2="6" y2="14" />
                            </svg>
                            Reports
                        </a>
                        }

                        @if (canManageUsers)
                        {
                            <a class="@TabClass("Users")" asp-controller="Users" asp-action="Index">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <line x1="19" y1="8" x2="19" y2="14" />
                                    <line x1="22" y1="11" x2="16" y2="11" />
                                </svg>
                                Staff
                            </a>
                            <a class="@TabClass("Roles")" asp-controller="Roles" asp-action="Index">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                    <polyline points="9 12 11 14 15 10" />
                                </svg>
                                Roles
                            </a>
                        }

                        @* Settings is not a place you work, so it sits apart at the far end. *@
                        @if (canSettings)
                        {
                        <a class="@TabClass("Settings") app-nav-icon" asp-controller="Settings" asp-action="Index"
                           title="Settings" aria-label="Settings">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="3" />
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
                            </svg>
                        </a>
                        }
                    }
                </nav>
            }
        </div>
    </header>

    <main class="container-fluid px-4 py-4">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <footer class="app-footer">
            <span>&copy; @DateTime.Today.Year @businessName. All rights reserved.</span>
            <span>Version 1.0.0</span>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
